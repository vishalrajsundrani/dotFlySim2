# GENERATED by tools/gen_rviz_cameras.py. Do not edit by hand.
#
# One Image display per camera the current drone carries, all disabled.
#
# WHY THEY ARE ALL OFF
# Rendering is demand-driven in this simulation: a camera sensor is
# always_on=false and its bridge row is lazy, so Gazebo renders it only while
# something subscribes. An RViz Image display subscribes when you enable it.
# That makes this file a camera CONTROL panel as much as a viewer -- tick a box
# and the lens starts rendering; untick it and the cost goes away.
#
# Opening this with every display enabled would switch all 19 cameras on at
# once, which on the payload lenses is about 1074 MP/s. Hence: all off.
#
# EVERY DISPLAY IS BEST EFFORT. Image streams are SensorDataQoS; a reliable
# subscriber never matches them and shows an empty panel with no error at all.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
  - Class: walker_rviz_panel/WalkerPanel
    Name: Walker
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 5
      Plane Cell Count: 40
      Color: 100; 100; 100
      Alpha: 0.4
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 2
    - Class: rviz_default_plugins/Image
      Name: payload · medium tele · photo
      # Disabled by default ON PURPOSE. Enabling an Image display subscribes,
      # and subscribing is exactly what makes Gazebo render that camera -- so
      # ticking a box here switches the lens on, and unticking it switches the
      # lens off again. RViz is a camera switch, not just a viewer.
      Enabled: false
      Topic:
        Value: /drone/camera/medium_tele/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/Image
      Name: payload · medium tele · preview
      # Disabled by default ON PURPOSE. Enabling an Image display subscribes,
      # and subscribing is exactly what makes Gazebo render that camera -- so
