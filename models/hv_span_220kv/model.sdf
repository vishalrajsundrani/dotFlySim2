<?xml version="1.0"?>
<sdf version="1.9">
  <!-- One 200 m span of 220 kV double-circuit line: 6 phase conductors and
       2 earth wires, each a real catenary (4.5 m of sag on the phases,
       3.5 m on the earth wires, which are strung tighter).

       GENERATED by tools/gen_powerline.py. Place it at the position of the
       tower the span STARTS at: the mesh runs from x=0 to x=200, at the same
       attachment heights the tower model hangs its insulators at, so
       tower_k and span_k share a pose.

       Conductor diameter is 29 mm and the earth wire 14 mm — real ACSR
       and OPGW sizes for this class. At 5 m the conductor is ~2 px wide in the
       m4e's 640x360 preview tier, which is the point: if it were drawn fatter,
       an inspection algorithm tuned in here would not survive contact with a
       real frame.

       Shadows are off on the wires. A 29 mm tube casting a shadow map
       costs a full extra pass to produce a line thinner than one shadow texel.
  -->
  <model name="hv_span_220kv">
    <static>true</static>
    <link name="link">
      <visual name="conductors">
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>meshes/conductors.obj</uri></mesh></geometry>
        <material>
          <ambient>0.16 0.16 0.17 1</ambient>
          <diffuse>0.34 0.35 0.36 1</diffuse>
          <specular>0.12 0.12 0.12 1</specular>
        </material>
      </visual>
      <visual name="earthwires">
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>meshes/earthwires.obj</uri></mesh></geometry>
        <material>
          <ambient>0.26 0.27 0.28 1</ambient>
          <diffuse>0.56 0.57 0.59 1</diffuse>
          <specular>0.30 0.30 0.32 1</specular>
        </material>
      </visual>
      <visual name="dampers">
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>meshes/dampers.obj</uri></mesh></geometry>
        <material>
          <ambient>0.18 0.18 0.19 1</ambient>
          <diffuse>0.38 0.38 0.40 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>

      <collision name="c0_0"><pose>16.67 -5.60 16.37 0 1.6457 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>33.43</length></cylinder></geometry></collision>
