<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="m4e">
    <pose>0 0 .24 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>

    <link name="base_link">
      <inertial>
        <mass>1.2190</mass>
        <inertia>
          <ixx>0.01753</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.01185</iyy>
          <iyz>0</iyz>
          <izz>0.02483</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay />

      <visual name="base_link_visual">
        <pose>0 0 0.025 0 0 -1.570796</pose>
        <transparency>0</transparency>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://m4e/meshes/m4_faceless.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.6 0.6 0.65 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <collision name="base_link_collision_0">
        <pose>0 0.025 0.035 0 0 0</pose>
        <geometry>
          <box>
            <size>0.64 0.56 0.13</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>

      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>

      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>

      <!-- IMU NOISE IS MEASURED, NOT INHERITED.
           Every number in the noise blocks below was derived from a real
           Matrice 4E: rosbag bag_000026, 184 s, from the 6.3 s the aircraft
           sat on the ground before takeoff. tools/imu_from_bag.py does the
           measuring and rewrites this block; do not hand-edit it, re-run the
           tool. The full derivation is in IMU_CALIBRATION.md.

           Three things about these values are not obvious.

           stddev is quoted AT 250 Hz, this sensor's update_rate, but the
           aircraft publishes at 50 Hz. A standard deviation means nothing
           without the rate it was sampled at, so the measurement was turned
           into a noise density and back up: stddev = density * sqrt(250).
           Change update_rate and these become wrong; re-run the tool.

           The density came from the flat top of the spectrum, not from the
           variance of the stationary segment. A parked aircraft sways on its
           legs, and on the x accelerometer that sway is 2.4x the white noise.
           Counting it as sensor noise would have made this model noisier than
           the part it represents.

           The accelerometer means are zero on purpose. DJI subtracts gravity
           from acceleration_body_raw before publishing it, so its mean mixes
           sensor bias with gravity removal error and is not a bias we can
           copy. The gyro means ARE real measured biases.

           dynamic_bias_stddev and dynamic_bias_correlation_time are still the
           inherited x500 figures: 6.3 s of stillness cannot support a 300 s
           correlation time, and a fitted number there would be invention. -->
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>-0.00056509389</mean>
                <stddev>0.00066325603</stddev>
                <dynamic_bias_stddev>3.22e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.00088365378</mean>
                <stddev>0.00060542074</stddev>
                <dynamic_bias_stddev>7.65e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>-0.00042490432</mean>
                <stddev>0.00060836685</stddev>
                <dynamic_bias_stddev>5.37e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0022675357</stddev>
                <dynamic_bias_stddev>0.00147</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>100</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0025002416</stddev>
                <dynamic_bias_stddev>0.000975</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>100</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.011341797</stddev>
                <dynamic_bias_stddev>0.00107</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>100</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>


        </imu>
      </sensor>

      <!-- THE HORIZONTAL STDDEV BELOW IS IN DEGREES, NOT METRES.
           SDFormat documents position_sensing/horizontal/noise/stddev as
           metres, but gz-sensors applies it to latitude and longitude
           directly, i.e. in degrees (gazebosim/gz-sensors issue #325). The
           4.5e-6 here is chosen against the implementation, not the spec:
           4.5e-6 deg x 111320 m/deg ~= 0.50 m, which is the sigma_p = 0.5 m
           that Cremona et al. (arXiv:2307.12836) use to model a conventional
           GNSS receiver, and what demo_gnss_stereo_inertial's GNSS factor is
           tuned against.

           IF GAZEBO EVER FIXES #325 THIS BECOMES 4.5 MICROMETRES and the
           simulated GNSS turns into a perfect position source overnight,
           silently. The symptom would be localization error collapsing to
           near zero and the GNSS residual going flat. Check this first.

           Vertical stddev really is metres: 1.0 m, deliberately worse than
           horizontal, as real GNSS altitude is. The paper notes the same
           asymmetry and an altitude bias it leaves to future work. -->
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <navsat>
          <position_sensing>
            <horizontal>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>4.5e-6</stddev>
              </noise>
            </horizontal>
            <vertical>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.0</stddev>
              </noise>
            </vertical>
          </position_sensing>
          <velocity_sensing>
            <horizontal>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.05</stddev>
              </noise>
            </horizontal>
            <vertical>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.1</stddev>
              </noise>
            </vertical>
          </velocity_sensing>
        </navsat>
      </sensor>

      <!-- ===================================================================
           FORWARD PERCEPTION STEREO PAIR
           ===================================================================
           The obstacle-avoidance cameras, as PSDK exposes them. On a real M4E
           these reach a payload through DjiPerception_SubscribePerception-
           Image(), and psdk_ros2 republishes them on
           perception_stereo_left_stream / ..._right_stream. Format and rate
           are taken from that aircraft, measured rather than assumed:
           mono8 704x704 at ~20 Hz (psdk-ros2 MANIFOLD3_FOXY_PSDK316_SETUP.md).

           ON base_link WITH A POSE, NOT ON A LINK OF THEIR OWN. A new link
           needs an <inertial> block, and any mass there changes the vehicle's
           total mass and inertia tensor, both tuned in this file and in the
           4900_gz_m4e airframe. Sensors are massless, so a pose offset buys
           the same geometry for nothing and cannot perturb the flight model.

           NOT ON m4e_camera EITHER. That model is teleported 50 times a second
           by gui/gimbal_stabilizer.py to cancel airframe roll and pitch, which
           is right for a gimbal and wrong for these: DJI's perception cameras
           are rigidly body-fixed, and a stereo pair that silently held itself
           level would make visual-inertial fusion look far better here than it
           can ever be on the aircraft.

           GEOMETRY IS AN ASSUMPTION, and deliberately kept in one place.
           DJI publishes neither the baseline nor the intrinsics of these
           cameras, and DjiPerception_GetStereoCameraParameters() segfaults on
           the M4E, so there is no way to read them off the aircraft either.
           The 0.09 m baseline is chosen against the 0.64 x 0.56 m airframe;
           90 degrees is a rectilinear stand-in for a fisheye pair's usable
           centre. Both numbers are mirrored in config/perception_calib.yaml,
           which is what any consumer should read. Change them together.

           Intrinsics by the same rule as the payload lenses (see the note in
           models/m4e_camera/model.sdf):
             fx = (w/2)/tan(hfov/2) = 352/tan(45 deg) = 352
             square sensor so vfov = hfov, fy = fx; cx = w/2, cy = h/2
           Rendering is demand-driven: both rows in config/bridge.yaml are
           lazy, so with no subscriber gz renders neither camera. -->
      <!-- ===================================================================
           THE FORWARD VISION PAIR, against the real aircraft's spec.

           The M4E carries SIX low-light fisheye lenses giving omnidirectional
           binocular vision. Only the FORWARD pair is modelled, because only
           the forward pair reaches the wrapper surface: psdk_ros2 publishes
           perception_stereo_left_stream and perception_stereo_right_stream and
           nothing else. Modelling the other four would cost GPU time that no
           topic would ever carry.

           FAITHFUL HERE
             horizontal FOV   90 degrees, matching the published figure
             image            704x704 mono8, matching what the wrapper streams
             rate             20 Hz, matching the observed stream rate

           NOT FAITHFUL, AND WHY
             vertical FOV     the real forward pair is 90 H by 135 V. A square
                              704x704 image cannot express that: Gazebo derives
                              vertical FOV from the image aspect, so this pair
                              sees 90 by 90. Matching the published 704x704
                              stream was judged more important than matching
                              the lens, since a consumer sees the stream.
             range            the real system measures 0.4 to 200 m forward.
                              A camera pair in Gazebo has no such limit; a
                              perception node that assumes one must impose it.

           Baseline: 90 mm (pose y = +/-0.045), mounted 0.30 m forward of the
           body origin on the nose. DJI does not publish the baseline, so this
           is a plausible value for the airframe rather than a measured one,
           and it IS load bearing: stereo depth scales with it, so a node
           calibrated against this simulation must be recalibrated against the
           aircraft.

           Source: DJI Matrice 4 Series specifications, enterprise.dji.com
           =================================================================== -->
      <sensor name="perception_front_left" type="camera">
        <pose>0.30 0.045 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/drone/perception/front/left/image_raw</topic>
        <gz_frame_id>perception_front_left</gz_frame_id>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>704</width>
            <height>704</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>200.0</far>
          </clip>
          <lens>
            <intrinsics>
              <fx>352.0</fx>
              <fy>352.0</fy>
              <cx>352.0</cx>
              <cy>352.0</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
        </camera>
      </sensor>

      <sensor name="perception_front_right" type="camera">
        <pose>0.30 -0.045 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/drone/perception/front/right/image_raw</topic>
        <gz_frame_id>perception_front_right</gz_frame_id>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>704</width>
            <height>704</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>200.0</far>
          </clip>
          <lens>
            <intrinsics>
              <fx>352.0</fx>
              <fy>352.0</fy>
              <cx>352.0</cx>
              <cy>352.0</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
        </camera>
      </sensor>

      <!-- ===================================================================
           THE REST OF THE OMNIDIRECTIONAL VISION SYSTEM.

           The M4E carries six low light fisheye lenses plus downward sensing.
           Only the forward pair reaches the wrapper surface (psdk_ros2 streams
           perception_stereo_left/right and nothing else), but the others are
           modelled because walker can switch any camera on individually and
           RViz can look through it, and because an obstacle avoidance node
           under test needs something behind and beside the aircraft to see.

           Every one of these is OFF unless something subscribes: the composer
           sets always_on=false and ros_gz_bridge is lazy, so an unused lens
           costs nothing. Measured in SPIKE-1.

           FIELDS OF VIEW, from DJI's published figures:
             forward / backward   90 deg H, 135 deg V, 0.4 to 200 m
             lateral              90 deg H,  90 deg V, 0.5 to 200 m
             downward            160 deg,             0.3 to  18.8 m

           The 135 deg vertical of the forward and backward pairs is NOT
           reproduced: these are square images, so Gazebo derives 90 deg
           vertical from the aspect. Matching the published 704x704 stream was
           judged more important than matching the lens.

           Intrinsics are derived, not guessed: fx = (width/2) / tan(hfov/2),
           with the principal point at the image centre.

           Source: DJI Matrice 4 Series specifications, enterprise.dji.com
           =================================================================== -->
      <!-- Backward vision, left. 90 deg H per DJI's forward/backward figure. -->
      <sensor name="perception_back_left" type="camera">
        <pose>-0.30 0.045 0 0 0 3.1416</pose>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/drone/perception/back/left/image_raw</topic>
        <gz_frame_id>perception_back_left</gz_frame_id>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>704</width>
            <height>704</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>200.0</far>
          </clip>
          <lens>
            <intrinsics>
              <fx>352.0</fx>
              <fy>352.0</fy>
              <cx>352.0</cx>
              <cy>352.0</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
        </camera>
      </sensor>

      <!-- Backward vision, right. -->
      <sensor name="perception_back_right" type="camera">
        <pose>-0.30 -0.045 0 0 0 3.1416</pose>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/drone/perception/back/right/image_raw</topic>
        <gz_frame_id>perception_back_right</gz_frame_id>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>704</width>
            <height>704</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>200.0</far>
          </clip>
          <lens>
            <intrinsics>
              <fx>352.0</fx>
              <fy>352.0</fy>
              <cx>352.0</cx>
              <cy>352.0</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
        </camera>
      </sensor>

      <!-- Lateral vision, left. DJI: 90 H x 90 V, 0.5 to 200 m. -->
      <sensor name="perception_left" type="camera">
        <pose>0 0.12 0 0 0 1.5708</pose>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/drone/perception/left/image_raw</topic>
        <gz_frame_id>perception_left</gz_frame_id>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>704</width>
            <height>704</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>200.0</far>
          </clip>
          <lens>
            <intrinsics>
              <fx>352.0</fx>
              <fy>352.0</fy>
              <cx>352.0</cx>
              <cy>352.0</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
        </camera>
      </sensor>

      <!-- Lateral vision, right. -->
      <sensor name="perception_right" type="camera">
        <pose>0 -0.12 0 0 0 -1.5708</pose>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/drone/perception/right/image_raw</topic>
        <gz_frame_id>perception_right</gz_frame_id>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>704</width>
            <height>704</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>200.0</far>
          </clip>
          <lens>
            <intrinsics>
              <fx>352.0</fx>
              <fy>352.0</fy>
              <cx>352.0</cx>
              <cy>352.0</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
        </camera>
      </sensor>

      <!-- Downward vision. DJI: 160 deg, 0.3 to 18.8 m. Used for landing and low-altitude hold. -->
      <sensor name="perception_down" type="camera">
        <pose>0 0 -0.04 0 1.5708 0</pose>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/drone/perception/down/image_raw</topic>
        <gz_frame_id>perception_down</gz_frame_id>
        <camera>
          <horizontal_fov>2.7925</horizontal_fov>
          <image>
            <width>640</width>
            <height>640</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>20.0</far>
          </clip>
          <lens>
            <intrinsics>
              <fx>56.4</fx>
              <fy>56.4</fy>
              <cx>320.0</cx>
              <cy>320.0</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
        </camera>
      </sensor>
    </link>

    <link name="rotor_0">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>0.11551 0.18056 0.06 0 0 0</pose>
      <inertial>
        <mass>0.016076923076923075</mass>
        <inertia>
          <ixx>3.8464910483993325e-07</ixx>
          <iyy>2.6115851691700804e-05</iyy>
          <izz>2.649858234714004e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_0_visual">
        <pose>-0.022 -0.14638461538461536 -0.016 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.8461538461538461 0.8461538461538461 0.8461538461538461</scale>
            <uri>model://x500_base/meshes/1345_prop_ccw.stl</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/DarkGrey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <collision name="rotor_0_collision">
        <pose>0 0 0 0 0 0 </pose>
        <geometry>
          <box>
            <size>0.2792307692307692 0.016923076923076923 0.0008461538461538462</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <link name="rotor_1">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>-0.16500 -0.15826 0.06 0 0 0</pose>
      <inertial>
        <mass>0.016076923076923075</mass>
        <inertia>
          <ixx>3.8464910483993325e-07</ixx>
          <iyy>2.6115851691700804e-05</iyy>
          <izz>2.649858234714004e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_1_visual">
        <pose>-0.022 -0.14638461538461536 -0.016 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.8461538461538461 0.8461538461538461 0.8461538461538461</scale>
            <uri>model://x500_base/meshes/1345_prop_ccw.stl</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/DarkGrey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <collision name="rotor_1_collision">
        <pose>0 0 0 0 0 0 </pose>
        <geometry>
          <box>
            <size>0.2792307692307692 0.016923076923076923 0.0008461538461538462</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="rotor_1_joint" type="revolute">

      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <link name="rotor_2">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>-0.16500 0.15826 0.06 0 0 0</pose>
      <inertial>
