      <sensor name="perception_dl" type="wideanglecamera">
        <pose>0  0.05 -0.04 0 1.5708 0</pose>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/drone/perception/dl/image_raw</topic>
