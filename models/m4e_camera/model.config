<?xml version="1.0"?>
<model>
  <name>m4e_camera</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>dotFlySim</name>
  </author>
  <description>
    Standalone camera/gimbal/lens assembly for the m4e drone. Kept as a
    separate, unconstrained model (not a child link of m4e itself) so it can
    be kinematically teleported by gui/gimbal_stabilizer.py via Gazebo's
    /world/default/set_pose service to cancel the drone's roll/pitch every
    tick -- this only works reliably on a free-standing model, not on a
    child link inside an articulated body's own kinematic tree.
  </description>
</model>
